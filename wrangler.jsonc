// DPRO CLINIC_SHUTTLE / MASTER STANDARD V2.1
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "dpro-clinic-shuttle-line-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://dpromstk2000-lab.github.io",
    "APP_ENVIRONMENT": "demo",
    "PRODUCTION_GUARD": "enabled",
    "DPRO_SYSTEM_CODE": "CLINIC_SHUTTLE",
    "SUPABASE_SCHEMA": "dpro_clinic_shuttle",
    "SUPABASE_URL": "https://cbknucemarcpbscirzyv.supabase.co"
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "SESSION_SECRET",
      "DEMO_ADMIN_CODE"
    ]
  }
}
